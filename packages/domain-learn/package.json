{
  "name": "@episteme/domain-learn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Learn domain pack: the vocabulary and rules of the Learn scene, registered into Core without changing it.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./distillation": {
      "types": "./dist/distillation.d.ts",
      "default": "./dist/distillation.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@episteme/core": "workspace:*",
    "@episteme/distillation": "workspace:*"
  }
}
