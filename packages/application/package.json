{
  "name": "@episteme/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The use-case layer every surface drives: ask, record, add, list, progress, over one learner's graph.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    },
    "./topic-file": {
      "types": "./dist/topic-file.d.ts",
      "default": "./dist/topic-file.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@episteme/agent": "workspace:*",
    "@episteme/core": "workspace:*",
    "@episteme/distillation": "workspace:*",
    "@episteme/domain-learn": "workspace:*",
    "@episteme/sdk": "workspace:*",
    "@episteme/storage-local": "workspace:*"
  }
}
