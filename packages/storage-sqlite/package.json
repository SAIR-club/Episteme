{
  "name": "@episteme/storage-sqlite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Durable storage for Episteme: one SQLite file per graph (WAL, held exclusively), holding its history and the stores kept with it.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@episteme/core": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13"
  }
}
