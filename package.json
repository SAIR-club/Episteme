{
  "name": "episteme",
  "version": "0.0.0",
  "private": true,
  "description": "Episteme turns inquiry into persistent, evolving understanding.",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --force",
    "pretest": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "pnpm --filter @episteme/example-learn-session demo",
    "demo:persistent": "pnpm --filter @episteme/example-persistent-session demo",
    "demo:semantic": "pnpm --filter @episteme/example-semantic-session demo",
    "demo:distill": "pnpm --filter @episteme/example-distill-session demo",
    "learn": "pnpm --filter @episteme/app-learn learn",
    "serve": "pnpm --filter @episteme/service build && node apps/service/dist/serve.js --workspace apps/learn/public",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.16.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
